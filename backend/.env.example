# Set these in your shell or load using your local environment manager.
DAYMAP_SECRET_KEY=replace-with-a-long-random-secret
DAYMAP_ENABLE_SCHEDULER=0
DAYMAP_SEED_DEMO=0
DAYMAP_CORS_ORIGINS=http://localhost:8081,http://localhost:19006
# OpenStreetMap-based Valhalla routing is the default (no key required).
DAYMAP_ROUTING_PROVIDER=valhalla
# Public demo endpoint: development/testing only. For production use a dedicated instance.
DAYMAP_VALHALLA_URL=https://valhalla1.openstreetmap.de/route
# Optional: set DAYMAP_ROUTING_PROVIDER=google and enable Google Directions API.
GOOGLE_MAPS_API_KEY=
# Google OAuth Web client (Calendar API enabled, redirect URI registered).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/google-calendar/callback
# Generate with: python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
GOOGLE_TOKEN_ENCRYPTION_KEY=

# Enable scheduler only in one running backend process.
DAYMAP_EVENT_REFRESH_HOURS=1
